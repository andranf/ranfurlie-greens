107-3526","107-7589 / 107-7590"],"cat":"https://www.toro.com/getpub/138264"},"seat":{"name":"Seat and seat switch","sys":"Operator station","desc":"Seat switch is part of the safety interlocks. Original Sand Pro seats are obsolete (bulletin 02-19): replacements come as seat kits. Replace the neutral and seat interlock switches every 1500 h.","parts":[],"cat":"https://www.toro.com/getpub/138264"},"rearhood":{"name":"Rear hood: engine (Briggs & Stratton V-twin)","sys":"Engine","desc":"B&S 305447-0285-G2 (Toro 120-3402), 2 plugs. Oil 1.66 L SAE 30 (API SL+). Oil and filter 107-7817 at 20 h then every 100 h. Air filter 108-3811 every 200 h (replace, do not clean). Every 800 h: plugs Champion RC14YC 0.76 mm 23 N.m, in-line fuel filter 94-2690, valve adjust and decarbon. Clean the cooling fins and oil cooler. Scott (Toro) serviced it at 988 h on 14 Oct 2026: rocker cover gasket refitted and dipstick tube seal 693172 changed to stop oil leaks.","parts":["107-7817","108-3811","Champion RC14YC","94-2690","115-7854","693172","44957"],"cat":"https://www.toro.com/getpub/138264"},"frame":{"name":"Frame, hydraulics and rear hitch","sys":"Hydraulics","desc":"Hydraulic reservoir 18.9 L Toro Premium All Season (or ISO VG 46 anti-wear). Hydraulic filter 54-0110 at 8 h, then every 400 h with the fluid. Grease the rear hitch (5 fittings) and traction-pedal pivot every 100 h. Lift cylinder 115-5647 seal kit 108-4597. Replace moving hoses every 1500 h.","parts":["54-0110","108-4597","44957"],"cat":"https://www.toro.com/getpub/138264"},"fork":{"name":"Front fork and wheel motor","sys":"Wheels and brakes","desc":"Grease the front wheel bearing every 100 h. Wheel motor seal kit 110-6459.","parts":["110-6459","107-7589 / 107-7590"],"cat":"https://www.toro.com/getpub/138264"},"tyreF":{"name":"Front tyre","sys":"Wheels and brakes","desc":"Knobby 2-ply 85-8290 (wheel and tyre 95-0621). 70 kPa (10 psi) treaded; smooth tyres 55-70 kPa. Lug nuts 95-122 N.m at 8 h and every 100 h.","parts":["85-8290"],"cat":"https://www.toro.com/getpub/138264"},"tyreR":{"name":"Rear tyre (right)","sys":"Wheels and brakes","desc":"Same tyre and pressure as the front. Lug nuts 95-122 N.m. Wheel motor seal kit 110-6459.","parts":["85-8290","110-6459"],"cat":"https://www.toro.com/getpub/138264"},"battery":{"name":"12 V battery","sys":"Electrical","desc":"Toro 104-8162. Check cable connections and electrolyte every 25 h.","parts":["104-8162"],"cat":"https://www.toro.com/getpub/138264"},"rake":{"name":"Rear rake attachment","sys":"Attachments","desc":"Tooth rake carbide tine pack 119-2152. Check the hitch pins and grease the hitch every 100 h.","parts":["119-2152"],"cat":"https://www.toro.com/getpub/138264"}},"SUB":{},"EXTRA":{"108-8442":{"name":"Steering box shim","note":""},"38-7820":{"name":"Steering box bearing","note":""},"107-1998":{"name":"Grease adapter for the steering pivot flush fitting","note":""},"693172":{"name":"Dipstick tube seal (grommet)","note":"Changed by Scott (Toro) 14 Oct 2026 at 988 h."}},"SNAP":{"107-7817":["Engine oil filter",19.5,"genuine",0,"Toro dealer (Amacron / GA Power Equipment Spares / Emmetts)","https://www.amacrongolf.com.au/products/b1147b2204/5592000019902031","20 h, 100 h"],"108-3811":["Air filter element",21.43,"equivalent",0,"Toro dealer","https://www.amacrongolf.com.au/products/ce54d26dba/5592000019464034","200 h"],"94-2690":["Fuel filter, in-line",8.21,"equivalent",0,"Toro dealer","https://www.amacrongolf.com.au/products/cf654ace81/5592000042651744","800 h"],"54-0110":["Hydraulic (transmission) filter",9.47,"genuine",3.0,"Toro dealer","https://www.toro.com/en/product/54-0110","8 h, 400 h"],"Champion RC14YC":["Spark plug (x2)",11.95,"genuine",0,"Auto/small-engine parts stores or Toro dealer",null,"800 h"],"115-7854":["Evap / carbon-canister line filter",8.21,"equivalent",0,"Toro dealer","https://www.amacrongolf.com.au/products/a58e60b2c2/5592000010701100",""],"104-8162":["Battery",null,null,0,"Toro dealer or battery specialist","https://www